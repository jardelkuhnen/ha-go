# === Motor cognitivo ===
# gemini | openai | ollama (obrigatória)
LLM_PROVIDER=ollama
# opcional; default por provedor (gemini-3.5-flash / gpt-4o-mini / llama3.2:3b)
LLM_MODEL=
# obrigatória quando LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# obrigatória quando LLM_PROVIDER=openai
# OPENAI_API_KEY=
# opcional; endpoint oficial quando vazio
# OPENAI_API_BASE=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT_S=30s

# === Home Assistant ===
# obrigatória (ex.: http://localhost:8123)
HA_URL=
# obrigatória — token de longa duração com permissão mínima
HA_TOKEN=
HA_TIMEOUT_S=5s
# obrigatória (ex.: media_player.alexa_sala)
ALEXA_MEDIA_ENTITY=

# === API do Cérebro ===
# obrigatória
BRAIN_API_KEY=
BRAIN_PORT=8000

# === Conhecidas-ignoradas (convivência com o .env do projeto Python; não consumidas) ===
# TAVILY_API_KEY=
# TELEGRAM_BOT_TOKEN=
# WHISPER_MODEL=
# ALLOWED_USERS=
# BRAIN_URL=
# BRAIN_TIMEOUT_S=
